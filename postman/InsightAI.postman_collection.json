                  "});",
                  "",
                  "var json = pm.response.json();",
                  "if ((!pm.collectionVariables.get('connectionId')) && json.data && Array.isArray(json.data.connections) && json.data.connections.length > 0) {",
                  "    pm.collectionVariables.set('connectionId', json.data.connections[0]._id);",
                  "}",
                  "",
                  "pm.test('Connections array exists', function () {",
                  "    pm.expect(Array.isArray(json.data.connections)).to.eql(true);",
                  "});"
